# Database & Caching
DATABASE_URL=postgresql+psycopg://cardboarddex:cardboarddex@localhost:5432/cardboarddex
REDIS_URL=redis://localhost:6379/0

# AWS S3 & CloudFront CDN
AWS_DEFAULT_REGION=us-west-2
S3_CARD_ASSETS_BUCKET=cardboarddex-card-assets-349558247779
S3_CUSTOM_DOMAIN=
CLOUDFRONT_DOMAIN=

# eBay Browse API Settings
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_DAILY_REQUEST_LIMIT=500
PRICE_COLLECTION_CARD_LIMIT=8

# Grading Fee Baseline
PSA_VALUE_FEE=24.99

# Administrative & Security
ADMIN_API_KEY=
ENABLE_API_DOCS=False

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_TRACK_ACTION_PER_MINUTE=30
RATE_LIMIT_HEAVY_PER_MINUTE=60

# Frontend & CORS Configuration
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Site traffic analytics (apply migration 0006 before enabling)
ANALYTICS_ENABLED=false
ANALYTICS_IDENTITY_SECRET=
ANALYTICS_TRUSTED_PROXY_CIDRS=
ADMIN_ALLOWED_ORIGINS=https://cardboarddex.app,https://www.cardboarddex.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,https://cardboarddex.nliu.org,https://www.cardboarddex.nliu.org
# Set false only for local HTTP development.
ADMIN_COOKIE_SECURE=true
# Set these in the frontend build environment, or frontend/.env.local.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ALLOW_LOCAL=false

# Scheduled passive pricing; worker + Beat must be running to collect.
PASSIVE_REFRESH_ENABLED=true
PASSIVE_PRIORITY_CARD_COUNT=1500
EBAY_SCHEDULED_REQUEST_LIMIT=450

# Pokémon Price Tracker: apply migrations through 0012 and follow docs/ppt-cutover.md.
PPT_API_KEY=
PPT_INGESTION_ENABLED=false
PPT_PRIMARY_ENABLED=false
PPT_DAILY_CREDIT_LIMIT=20000
PPT_MINUTE_WEIGHT_LIMIT=55
PPT_BATCH_SIZE=8

# Local development only; public production reads must never rebuild market rankings.
MARKET_SNAPSHOTS_ON_DEMAND_FALLBACK=false
