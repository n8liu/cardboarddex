# Copy outside the checkout to /etc/cardboarddex/app.env, chmod 600.
APP_ENV_FILE=/etc/cardboarddex/app.env
DATA_VOLUME=app_postgres_data
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
BACKEND_IMAGE=
POSTGRES_IMAGE=
REDIS_IMAGE=
CLOUDFLARED_IMAGE=
TUNNEL_TOKEN=
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis-cache:6379/0
TCGAPI_API_KEY=
TCGAPI_BASE_URL=https://api.tcgapi.dev/v1
TCGAPI_DAILY_REQUEST_LIMIT=2000
TCGAPI_SYNC_SET_LIMIT=250
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_DAILY_REQUEST_LIMIT=500
PRICE_COLLECTION_CARD_LIMIT=5
BACKEND_CORS_ORIGINS=https://cardboarddex.app,https://www.cardboarddex.app,https://cardboarddex.pages.dev
ADMIN_API_KEY=
ENABLE_API_DOCS=false
S3_BUCKET_NAME=
AWS_REGION=us-west-2
CLOUDFRONT_DOMAIN=
PSA_VALUE_FEE=24.99
